# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# The GitHub token the station publishes with. App Lab offers no way to put a
# variable in the container's environment, so the token travels as a file in
# the app folder, which is bind-mounted into it. This repository is public:
# committing this file would hand anyone write access to it.
.sismo-token

# Local config & data
python/config.yaml
*.local.yaml
data/
*.db
calibration_state.json
classifier_state.json
distance_state.json
# The detection journal: station-specific, append-only, grows without bound.
# Replay it with `python audit.py`; do not commit it.
event_log.jsonl
events_log.jsonl

# OS / editors
.DS_Store
.vscode/
.idea/

